    {
    "text": "Coming soon...",
    "gradient": "linear-gradient(180deg, #bafff2 0%, #3c35fc 100%)",
    "fontSize": "2.8rem",
    "fontWeight": "800",
    "textTransform": "uppercase",
    "letterSpacing": "2px",
    "lineHeight": "1.2",
    "marginBottom": "12px"
  }
  ],
  "media": {
    "type": "image",
    "url": "IMG/ermialogo.png",
    "alt": "ERMIA's logo",
