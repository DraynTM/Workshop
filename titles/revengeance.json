{
  "id": "sandbox",
  "style": {
    "googleFont": "Jersey 10",
    "fontFamily": "'Jersey 10', sans-serif",
    "background": "linear-gradient(to bottom, rgba(15,17,23,0.85) 0%, rgba(15,17,23,0.2) 20%, rgba(15,17,23,0.2) 80%, rgba(15,17,23,0.85) 100%), url('IMG/BG-rev.png') center/cover no-repeat",
    "padding": "60px 40px",
    "minHeight": "550px",
    "maxWidth": "1100px",
    "borderRadius": "0px",
    "border": "0px solid rgba(255, 255, 255, 0.12)",
    "boxShadow": "0 20px 50px rgba(0, 0, 0, 0.6), inset 0 1px 1px rgba(255, 255, 255, 0.1)",
    "backdropFilter": "blur(0px)"
  },
  "layout": {
    "direction": "column",
    "alignItems": "center",
    "justifyContent": "center",
    "gap": "28px",
    "textAlign": "center"
  },
  "header": {
    "titleImage": "IMG/revlogo.webp",
    "titleColor": "#FFFFFF",
    "titleSize": "clamp(3.5rem, 8vw, 7.5rem)",
    "titleWeight": "900",
    "letterSpacing": "6px",
    "textShadow": "0 10px 30px rgba(0, 0, 0, 0.8), 0 0 20px rgba(255, 255, 255, 0.2)"
  },
  "content": {
    "text": "Collect the Animatronics/Skins, Defeat the Bosses or find they in Open World. Fight with Animatronic Bosses, every Boss has his own unique attacks and environment. Explore the world, Talks & Trade with characters.",
    "textColor": "#ddd5eb",
    "fontSize": "1.5rem",
    "lineHeight": "1.5"
  },
  "buttons": {
    "overlay": true,
    "label": "Available on:",
    "labelColor": "#ffffff",
    "labelFontSize": "1.8rem",
    "labelTextShadow": "0 2px 6px rgba(0, 0, 0, 0.9)",
    "items": [
      {
        "ariaLabel": "Itch io",
        "icon": "fab fa-itch-io",
        "url": "https://the-drayn.itch.io/fnaf-rev",
        "className": "social-btn"
      },
      {
        "ariaLabel": "Game Jolt",
        "icon": "fas fa-bolt",
        "imageUrl": "https://s.gjcdn.net/img/favicon.png",
        "url": "https://gamejolt.com/games/fnafrev/736290",
        "className": "social-btn"
      }
    ]
  }
}