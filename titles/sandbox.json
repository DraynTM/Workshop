{
  "id": "sandbox",
  "style": {
    "googleFont": "Montserrat",
    "fontFamily": "'Montserrat', sans-serif",
    "background": "linear-gradient(135deg, rgba(15, 17, 23, 0.88) 0%, rgba(15, 17, 23, 0.65) 50%, rgba(15, 17, 23, 0.92) 100%), url('IMG/BG-sandbox.png') center/cover no-repeat",
    "padding": "60px 40px",
    "minHeight": "550px",
    "maxWidth": "1100px",
    "borderRadius": "0px",
    "border": "0px solid rgba(255, 255, 255, 0.12)",
    "boxShadow": "0 20px 50px rgba(0, 0, 0, 0.6), inset 0 1px 1px rgba(255, 255, 255, 0.1)",
    "backdropFilter": "blur(0px)"
  },
  "layout": {
    "direction": "column",
    "alignItems": "center",
    "justifyContent": "center",
    "gap": "28px",
    "textAlign": "center"
  },
  "header": {
    "title": "SANDBOX",
    "titleColor": "#FFFFFF",
    "titleSize": "clamp(3.5rem, 8vw, 7.5rem)",
    "titleWeight": "900",
    "letterSpacing": "6px",
    "textShadow": "0 10px 30px rgba(0, 0, 0, 0.8), 0 0 20px rgba(255, 255, 255, 0.2)"
  },
  "content": {
    "text": "In this game you can create your own maps and share them with your friends or with the whole world. The editor has a huge number of tiles, decorations and NPCs. The game also has 3 game modes - CLASSIC, CHASING and MASK. Among other things, the game also has triggers that make the gameplay more fun =)",
    "textColor": "#ddd5eb",
    "fontSize": "1.1rem",
    "lineHeight": "1.5"
  },
  "buttons": {
    "overlay": true,
    "label": "Available on:",
    "labelColor": "#ffffff",
    "labelFontSize": "1.1rem",
    "labelTextShadow": "0 2px 6px rgba(0, 0, 0, 0.9)",
    "items": [
      {
        "ariaLabel": "Itch io",
        "icon": "fab fa-itch-io",
        "url": "https://the-drayn.itch.io/fnaf-sandbox",
        "className": "social-btn"
      },
      {
        "ariaLabel": "Game Jolt",
        "icon": "fas fa-bolt",
        "imageUrl": "https://s.gjcdn.net/img/favicon.png",
        "url": "https://gamejolt.com/games/fnafsandbox/690669",
        "className": "social-btn"
      }
    ]
  }
}